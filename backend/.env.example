# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/surfbud

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=change-me-to-a-32-char-minimum-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
REFRESH_COOKIE_NAME=refreshToken

# CORS (comma-separated origins; optional)
CORS_ORIGIN=

# Logging
LOG_LEVEL=info

# SSE ticket expiry
SSE_TICKET_EXPIRES_IN=5m

# AWS S3 (optional; required for profile photo upload)
# If AWS_S3_BUCKET is set, AWS_ACCESS_KEY and AWS_SECRET_ACCESS_KEY are required
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=

# Redis (optional; for distributed rate limiting across multiple instances)
# When not set, rate limits use in-memory store (per-process)
# REDIS_URL=redis://localhost:6379

# Dashboard / Extension (for reference; set in dashboard or extension .env)
# VITE_API_BASE_URL=http://localhost:3000/api/v1
# VITE_EXTENSION_ID=
# VITE_DASHBOARD_URL=http://localhost:5173
